# Database — for Supabase, use the pooled connection (port 6543) for
# DATABASE_URL and the direct connection (port 5432) for DIRECT_URL, since
# migrations need a non-pooled connection. For plain local Postgres, both
# can point at the same local URL.
DATABASE_URL="postgresql://user:password@localhost:5432/nurd_custom_lab"
DIRECT_URL="postgresql://user:password@localhost:5432/nurd_custom_lab"

# Auth (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Storage (S3-compatible — swap for Cloudinary if preferred)
S3_BUCKET_NAME="nurd-custom-lab-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@projectnurd.example"

# Error tracking / analytics (optional for MVP)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
